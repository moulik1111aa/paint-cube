{
  "appId": "com.paintcube.app",
  "appName": "Paint Cube",
  "webDir": "www",
  "backgroundColor": "#0B0B12",
  "loggingBehavior": "production",
  "android": {
    "backgroundColor": "#0B0B12",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "hidden": true
    }
  }
}
